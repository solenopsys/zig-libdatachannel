+int rtcCreateWebSocketWithHeader(const char *url, const char *headerName,
+                                 const char *headerValue) {
+	return wrap([&] {
+		if (!url || !headerName || !headerValue)
+			throw std::invalid_argument("Unexpected null pointer");
+
+		auto webSocket = std::make_shared<WebSocket>();
+		webSocket->open(url, {{string(headerName), string(headerValue)}});
+		return emplaceWebSocket(webSocket);
+	});
+}
